# Device Management System - Beispiel Konfiguration
# Kopiere diese Datei zu .env und passe die Werte an

# API Konfiguration
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production-for-real-usage

# Datenbank
DATABASE_URL=sqlite:///./device_management.db

# GLPI Konfiguration
GLPI_BASE_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# OCR Konfiguration (Phase 1b)
OCR_LANGUAGE=deu+eng
OCR_INPUT_WATCH_PATH=/mnt/samba/glpi-formulare/eingang
OCR_PROCESSING_PATH=/mnt/samba/glpi-formulare/in-bearbeitung
OCR_DONE_PATH=/mnt/samba/glpi-formulare/erledigt
OCR_ERROR_PATH=/mnt/samba/glpi-formulare/fehler
OCR_ARCHIVE_PATH=/mnt/samba/glpi-formulare/archiv

# Netzwerk-Scanning (Phase 2)
DEFAULT_SCAN_TIMEOUT=5
MAC_VENDOR_DB_URL=https://standards-oui.ieee.org/oui/oui.txt

# Sicherheit
ENABLE_AUDIT_LOG=true
AUDIT_LOG_PATH=./logs/audit.log